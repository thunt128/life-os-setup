# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored, so your keys never get pushed to GitHub.

# --- Supabase (Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic / Claude (Phase 3: AI features) ---
# Server-only — used by the /app/api routes, never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5). For this light
# personal tool, claude-haiku-5-5 or claude-sonnet-5-5 are cheaper and faster.
ANTHROPIC_MODEL=

# --- OpenAI Whisper (Phase 4: voice transcription) ---
OPENAI_API_KEY=

# --- Telegram bot (Phase 4: voice capture) ---
TELEGRAM_BOT_TOKEN=
