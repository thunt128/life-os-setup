# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored, so your keys never get pushed to GitHub.

# --- Supabase (Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic / Claude (Phase 3: AI features) ---
ANTHROPIC_API_KEY=

# --- OpenAI Whisper (Phase 4: voice transcription) ---
OPENAI_API_KEY=

# --- Telegram bot (Phase 4: voice capture) ---
TELEGRAM_BOT_TOKEN=
